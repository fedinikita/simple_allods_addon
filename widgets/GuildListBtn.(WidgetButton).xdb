<?xml version="1.0" encoding="UTF-8"?>
<WidgetButton>
	<Name>GuildListBtn</Name>
	<Priority>20</Priority>
	<TextTag>btn_label</TextTag>
	<clipContent>false</clipContent>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Pos>10</Pos>
			<HighPos>0</HighPos>
			<Size>140</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Pos>10</Pos>
			<HighPos>0</HighPos>
			<Size>28</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<Variants>
		<Item>
			<PushedOffset x="-2" y="2" />
			<StateNormal>
				<LayerMain href="../Textures/GUI/MsgBoxButton.(WidgetLayerTiledTexture).xdb#xpointer(/WidgetLayerTiledTexture)" />
				<FormatFileRef href="ButtonFormat.txt" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="../Textures/GUI/MsgBoxButtonPressed.(WidgetLayerTiledTexture).xdb#xpointer(/WidgetLayerTiledTexture)" />
			</StatePushed>
			<ReactionOnUp>true</ReactionOnUp>
			<Reaction>guildlist</Reaction>
		</Item>
	</Variants>
	<TextStyle>
		<Align>ALIGNY_MIDDLE</Align>
	</TextStyle>
</WidgetButton>
